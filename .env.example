# Copy to .env.local for local development. Do not put real credentials in Git.
# The current community MVP does not require Supabase; these are documented only for a future backend migration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_SERVICE_ROLE_KEY=never-commit-a-real-service-role-key
LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/database
