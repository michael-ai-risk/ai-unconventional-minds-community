# Names only; copy values into ignored .dev.vars locally or Cloudflare settings.
# Public build-time site key for the Turnstile widget.
VITE_TURNSTILE_SITE_KEY=<public-turnstile-site-key>
# Worker secrets (never commit real values).
TURNSTILE_SECRET_KEY=<turnstile-secret-key>
BETTER_AUTH_SECRET=<random-secret-with-at-least-32-bytes-of-entropy>
ADMIN_BOOTSTRAP_SECRET=<one-time-random-secret-remove-after-first-admin-setup>
# Exact local/preview origin, e.g. http://localhost:8787.
SITE_ORIGIN=<exact-site-origin>
# D1 binding: DB (configured in wrangler.jsonc; use a real Cloudflare database_id before deploy).
